# ---------------------------------------------------------------------------
# DDLsmith
#
# Tracked on purpose (do NOT add rules for these):
#   src/, docs/            sources, the design/ER documents and the research
#                          probes under docs/er_features/
#   config.json            the default connection settings the README documents
#
# Everything a run produces - logs/ (failure logs), bugs/ (the filed defect
# reports), the embedded databases and the --ddl-dump scripts - is output, not a
# deliverable: a run regenerates it from a seed.
# ---------------------------------------------------------------------------

# --- Build output ----------------------------------------------------------
target/
*.class
dependency-reduced-pom.xml

# --- Run output ------------------------------------------------------------
# Failure logs and --log-each-select traces.
logs/

# The per-run defect reports the tool files into --bug-dir (default `bugs`).
# Kept out of the repository because they are results about a specific engine
# version on a specific machine, not part of the tool.
bugs/

# Campaign scratch space: one directory per acceptance round, each holding its
# chunk logs, per-chunk bug directories and the embedded databases it created.
# Hundreds of MB per round, all of it regenerable from a seed. The harness
# scripts that drive a round are code and stay tracked; a round's reports and
# captured inputs are results and do not.
runs/*
!runs/*.sh
!runs/*.py

# Every generated DDL script (--ddl-dump-dir) and exported ER diagram.
*-ddl-dump/
*.ddl-dump/

# --- Embedded databases ----------------------------------------------------
# SQLite *.db, DuckDB *.duckdb, H2 *.mv.db / *.trace.db, plus their journals.
*.db
*.duckdb
*.db-journal
*.db-wal
*.db-shm
*.duckdb.wal

# --- Logs ------------------------------------------------------------------
*.log
hs_err_pid*.log
replay_pid*.log

# Machine-specific build settings (a JDK path, a private config path).
build.local.*

# --- IDE / editor ----------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath
*.swp
*~

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Python (the research probes under docs/er_features) -------------------
__pycache__/
*.py[cod]
.venv/
venv/
