<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.ddlsmith</groupId>
  <artifactId>DDLsmith</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>DDLsmith</name>
  <description>Random graph -> ER diagram -> relational DDL testing</description>
  <url>https://github.com/hkjiang26/DDLsmith</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>hkjiang26</id>
      <name>Haikuo Jiang</name>
      <email>1534003403@qq.com</email>
      <organization>Nanchang University GOOD Lab</organization>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/hkjiang26/DDLsmith.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/hkjiang26/DDLsmith.git</developerConnection>
    <url>https://github.com/hkjiang26/DDLsmith</url>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencies>
    <!-- CLI -->
    <dependency>
      <groupId>com.beust</groupId>
      <artifactId>jcommander</artifactId>
      <version>1.82</version>
    </dependency>

    <!-- JSON (config.json / ER diagram export) -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.9.1</version>
    </dependency>

    <!-- Embedded engines (always available, used for differential testing with no infrastructure) -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.49.1.0</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.3.232</version>
    </dependency>
    <dependency>
      <groupId>org.duckdb</groupId>
      <artifactId>duckdb_jdbc</artifactId>
      <version>1.3.0.0</version>
    </dependency>

    <!-- Server engines (optional, used when a server is reachable) -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.5</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.0.33</version>
    </dependency>

    <!-- Logging -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>1.7.36</version>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.2</version>
      <scope>test</scope>
    </dependency>
    <!-- lets the test suite be run without a full-project compile, which matters while
         engine modules are developed independently -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-console-standalone</artifactId>
      <version>1.11.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>DDLsmith</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.10.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>2.22.2</version>
        <configuration>
          <argLine>-Dfile.encoding=UTF-8</argLine>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>org.ddlsmith.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- Fat jar: java -jar target/DDLsmith.jar <dbms> ... -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.ddlsmith.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>

    <!--
      Compiles the whole main tree into target/core-api-classes and writes the dependency
      classpath to target/cp.txt.

      This is for the standalone self-check programs (the *SelfCheck classes under src/test),
      which are plain `main` programs rather than JUnit tests and are therefore not run by
      surefire. They need a compiled classpath, which is exactly what this profile emits:

        mvn -Pcore-api process-classes
        javac -encoding UTF-8 -cp "target/core-api-classes<sep>$(cat target/cp.txt)" \
              -d target/h2-classes src/main/java/org/ddlsmith/dbms/h2/*.java
        java -cp "target/h2-classes<sep>target/core-api-classes<sep>$(cat target/cp.txt)" \
              org.ddlsmith.dbms.h2.SelfCheck

      (<sep> is ; on Windows and : elsewhere.)
    -->
    <profile>
      <id>core-api</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>write-dependency-classpath</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>build-classpath</goal>
                </goals>
                <configuration>
                  <outputFile>${project.build.directory}/cp.txt</outputFile>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>compile-core-api</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <property name="core.dir" value="${project.build.directory}/core-api-classes"/>
                    <loadfile property="dep.cp" srcFile="${project.build.directory}/cp.txt"/>
                    <delete dir="${core.dir}"/>
                    <mkdir dir="${core.dir}"/>
                    <javac srcdir="${project.basedir}/src/main/java" destdir="${core.dir}"
                           classpath="${dep.cp}" release="17" encoding="UTF-8"
                           nowarn="true" includeantruntime="false" fork="true"/>
                    <echo message="core API compiled to ${core.dir}; dependency classpath in ${project.build.directory}/cp.txt"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Verifies that the graph-conformance extension oracle compiles against the core API
      alone. The main tree is first compiled with org/ddlsmith/conformance excluded, and the
      extension is then compiled against that core-only classpath (with no sourcepath, so a
      reference cannot be satisfied by recompiling a sibling source file).

      This is what backs the claim in README section 12: the extension plugs in through
      META-INF/services and the core API, not through an edit to the oracle layer.

        mvn -Pextension-check process-classes
    -->
    <profile>
      <id>extension-check</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>write-dependency-classpath</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>build-classpath</goal>
                </goals>
                <configuration>
                  <outputFile>${project.build.directory}/cp.txt</outputFile>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>compile-extension-against-core-api</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <property name="core.dir" value="${project.build.directory}/core-api-classes"/>
                    <property name="ext.dir" value="${project.build.directory}/extension-classes"/>
                    <loadfile property="dep.cp" srcFile="${project.build.directory}/cp.txt"/>
                    <delete dir="${core.dir}"/>
                    <delete dir="${ext.dir}"/>
                    <mkdir dir="${core.dir}"/>
                    <mkdir dir="${ext.dir}"/>

                    <!-- 1. the core, without the extension -->
                    <javac srcdir="${project.basedir}/src/main/java" destdir="${core.dir}"
                           classpath="${dep.cp}" release="17" encoding="UTF-8"
                           nowarn="true" includeantruntime="false" fork="true">
                      <exclude name="org/ddlsmith/conformance/**"/>
                    </javac>

                    <!-- 2. the extension, against that core only (sourcepath is the class-only dir) -->
                    <javac srcdir="${project.basedir}/src/main/java" destdir="${ext.dir}"
                           sourcepath="${core.dir}"
                           classpath="${core.dir}${path.separator}${dep.cp}"
                           release="17" encoding="UTF-8"
                           nowarn="true" includeantruntime="false" fork="true">
                      <include name="org/ddlsmith/conformance/**"/>
                    </javac>
                    <echo message="extension oracle compiled against the core API alone: ${ext.dir}"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

  </profiles>
</project>
